  <credit page="1"><credit-type>title</credit-type><credit-words font-size="20">Printed title</credit-words></credit>
  <part-list><score-part id="P1"><part-name>Voice and piano</part-name></score-part></part-list>
  <part id="P1">
    <measure number="1" width="210">
      <print new-system="yes"><system-layout><system-distance>90</system-distance></system-layout></print>
      <attributes><divisions>4</divisions><key><fifths>-1</fifths><mode>major</mode></key><time><beats>4</beats><beat-type>4</beat-type></time><staves>2</staves><clef number="1"><sign>G</sign><line>2</line></clef><clef number="2"><sign>F</sign><line>4</line></clef></attributes>
      <direction placement="above"><direction-type><words>Keep tempo</words><dynamics><p/></dynamics></direction-type><sound tempo="88"/></direction>
      <harmony><root><root-step>F</root-step></root><kind text="F">major</kind><degree><degree-value>9</degree-value><degree-alter>0</degree-alter><degree-type>add</degree-type></degree><staff>1</staff></harmony>
      <!-- Mixed sizes carry duration and share a stem. -->
      <note default-x="30"><pitch><step>A</step><octave>4</octave></pitch><duration>4</duration><tie type="start"/><voice>1</voice><type>quarter</type><stem>up</stem><staff>1</staff><notations><tied type="start"/><slur type="start" number="1"/><articulations><accent/></articulations></notations><lyric number="1"><syllabic>single</syllabic><text>ta</text><extend type="start"/></lyric></note>
      <note default-x="30"><chord/><pitch><step>C</step><octave>5</octave></pitch><duration>4</duration><voice>1</voice><type size="cue">quarter</type><stem>up</stem><notehead font-size="small">normal</notehead><staff>1</staff></note>
      <note><rest/><duration>12</duration><voice>1</voice><type>half</type><dot/><staff>1</staff></note>
      <backup><duration>16</duration></backup>
      <note><pitch><step>F</step><octave>3</octave></pitch><duration>8</duration><voice>2</voice><type>half</type><stem>down</stem><staff>2</staff><lyric number="2"><syllabic>begin</syllabic><text>cùng</text><elision> </elision><text>đem</text></lyric></note>
